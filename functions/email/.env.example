# Reference only. Copy to .env.dnd-loot-site for the real deployment.
# This file and all local .env files stay out of Hosting/Functions uploads.
EMAIL_DELIVERY_ENABLED=false
EMAIL_FROM="CampaignAtlas <invites@your-verified-domain.example>"
EMAIL_REPLY_TO=
EMAIL_SITE_URL=https://dnd-loot-site.web.app
EMAIL_DAILY_LIMIT=50
# RESEND_API_KEY belongs in Firebase Secret Manager, never in this file.
