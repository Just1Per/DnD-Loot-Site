// D&D Vault Firestore Rules Revision: 29
// Character sheet schema: 14 — draggable tabs + page manager + companion database
// Revision 14: campaign DMs may create characters for active campaign members
// Revision 15: character-sheet visual parity iteration; permissions unchanged
// Revision 16: Adobe class/subclass progression iteration; permissions unchanged
// Revision 17: parity audit + character-sheet style loading sync; permissions unchanged
// Revision 18: DM permanent character deletion + schema 14 tab layout state
// Revision 19: persist normalized advancement state and keep schema 12/13 Adobe saves compatible
// Revision 20: expanded first-party race/background/subclass catalogues; permissions and schema unchanged
// Revision 21: spell-generator filtering + Feats-page choice flow; permissions and schema unchanged
// Revision 22: unified Vault character-sheet visual theme; permissions and schema unchanged
// Revision 23: validate multi-companion payloads and optional Companion/Rules page state
// Revision 24: stop legacy advancement.companion schema from rejecting Adobe multi-companion saves
// Revision 25: stable character-sheet envelope validation; content schema is versioned by the app
// Revision 27: character owners may permanently delete their own roster + private sheet records
// Revision 26: normalized global rules catalogue collections (classes, subclasses, species, backgrounds, feats, spells)
rules_version = '2';
service cloud.firestore {
match /databases/{database}/documents {

// -----------------------------------------------------------------------
// GLOBAL HELPERS
// -----------------------------------------------------------------------
function signedIn() {
  return request.auth != null;
}

function isSelf(uid) {
  return signedIn() && request.auth.uid == uid;
}

function userPath(uid) {
  return /databases/$(database)/documents/users/$(uid);
}

function hasGlobalRole(role) {
  return signedIn()
    && exists(userPath(request.auth.uid))
    && get(userPath(request.auth.uid)).data.role is list
    && role in get(userPath(request.auth.uid)).data.role;
}

function isAdmin() {
  return hasGlobalRole("admin");
}

// Temporary global capability: an approved DM may CREATE campaigns.
// Long-term recommendation: replace this with a server-managed
// canCreateCampaigns custom claim / capability.
function canCreateCampaigns() {
  return isAdmin() || hasGlobalRole("dm");
}

function hasAuthEmail() {
  return signedIn()
    && request.auth.token.email is string;
}

function authEmailLower() {
  return signedIn() && request.auth.token.email is string
    ? request.auth.token.email.lower()
    : "";
}

// -----------------------------------------------------------------------
// CAMPAIGN / INVITE HELPERS
// -----------------------------------------------------------------------
function campaignPath(campaignId) {
  return /databases/$(database)/documents/campaigns/$(campaignId);
}

function memberPath(campaignId, uid) {
  return /databases/$(database)/documents/campaigns/$(campaignId)/members/$(uid);
}

function characterPath(campaignId, charId) {
  return /databases/$(database)/documents/campaigns/$(campaignId)/characters/$(charId);
}

function userCampaignPath(uid, campaignId) {
  return /databases/$(database)/documents/users/$(uid)/campaigns/$(campaignId);
}

function invitePath(inviteId) {
  return /databases/$(database)/documents/campaignInvites/$(inviteId);
}

function campaignExists(campaignId) {
  return exists(campaignPath(campaignId));
}

function isCampaignOwner(campaignId) {
  return signedIn()
    && campaignExists(campaignId)
    && get(campaignPath(campaignId)).data.ownerId == request.auth.uid;
}

function isActiveMember(campaignId) {
  return signedIn()
    && exists(memberPath(campaignId, request.auth.uid))
    && get(memberPath(campaignId, request.auth.uid)).data.status == "active";
}

function isCampaignDM(campaignId) {
  return isCampaignOwner(campaignId)
    || (
      isActiveMember(campaignId)
      && get(memberPath(campaignId, request.auth.uid)).data.role == "dm"
    );
}

function validMemberData(uid) {
  return request.resource.data.uid == uid
    && request.resource.data.role in ["player", "dm"]
    && request.resource.data.status in ["invited", "active"];
}

function inviteBelongsToCurrentUser(inviteData) {
  return signedIn() && (
    ("targetUid" in inviteData && inviteData.targetUid == request.auth.uid)
    || (hasAuthEmail() && inviteData.emailLower is string && inviteData.emailLower != "" && inviteData.emailLower == authEmailLower())
  );
}

// Used by the invitee while accepting an invitation. The invite must be
// pending before the batch and accepted by this same user after the batch.
function validInviteMembershipWrite(campaignId, uid) {
  return isSelf(uid)
    && "inviteId" in request.resource.data
    && request.resource.data.inviteId is string
    && request.resource.data.uid == uid
    && request.resource.data.role in ["player", "dm"]
    && request.resource.data.status == "active"
    && exists(invitePath(request.resource.data.inviteId))
    && get(invitePath(request.resource.data.inviteId)).data.status == "pending"
    && get(invitePath(request.resource.data.inviteId)).data.campaignId == campaignId
    && get(invitePath(request.resource.data.inviteId)).data.role == request.resource.data.role
    && inviteBelongsToCurrentUser(get(invitePath(request.resource.data.inviteId)).data)
    && getAfter(invitePath(request.resource.data.inviteId)).data.status == "accepted"
    && getAfter(invitePath(request.resource.data.inviteId)).data.acceptedBy == uid
    && getAfter(userCampaignPath(uid, campaignId)).data.status == "active"
    && getAfter(userCampaignPath(uid, campaignId)).data.role == request.resource.data.role;
}

function validInviteUserIndexWrite(uid, campaignId) {
  return isSelf(uid)
    && "inviteId" in request.resource.data
    && request.resource.data.inviteId is string
    && request.resource.data.role in ["player", "dm"]
    && request.resource.data.status == "active"
    && exists(invitePath(request.resource.data.inviteId))
    && get(invitePath(request.resource.data.inviteId)).data.status == "pending"
    && get(invitePath(request.resource.data.inviteId)).data.campaignId == campaignId
    && get(invitePath(request.resource.data.inviteId)).data.role == request.resource.data.role
    && inviteBelongsToCurrentUser(get(invitePath(request.resource.data.inviteId)).data)
    && getAfter(invitePath(request.resource.data.inviteId)).data.status == "accepted"
    && getAfter(invitePath(request.resource.data.inviteId)).data.acceptedBy == uid
    && getAfter(memberPath(campaignId, uid)).data.status == "active"
    && getAfter(memberPath(campaignId, uid)).data.role == request.resource.data.role;
}

function validItemStateKeys() {
  return request.resource.data.keys().hasOnly([
    "visible",
    "looted",
    "highlighted",
    "owner",
    "receivedDate",
    "updatedAt",
    "updatedBy"
  ]);
}

function validItemStateOwner(campaignId) {
  return !("owner" in request.resource.data)
    || request.resource.data.owner == null
    || exists(characterPath(campaignId, request.resource.data.owner));
}

function saveCharacterBelongsTo(campaignId, data, uid) {
  return "characterId" in data
    && exists(characterPath(campaignId, data.characterId))
    && get(characterPath(campaignId, data.characterId)).data.userId == uid;
}

// -----------------------------------------------------------------------
// MASTER ITEMS
// Global catalogue. Campaign-specific state must NOT live here.
// -----------------------------------------------------------------------
// Global reference rules only; no campaign or character records in this collection.
match /rulesCatalog/{release} {
  allow read: if request.auth != null;
  allow write: if isAdmin();
  // Legacy chunked spell/feat catalogue remains readable during migration.
  match /parts/{part} {
    allow read: if signedIn();
    allow write: if isAdmin();
  }

  // Normalized v2 reference records. These are global and never campaign-owned.
  match /{kind}/{recordId} {
    allow read: if signedIn()
      && kind in ['classes', 'subclasses', 'species', 'backgrounds', 'feats', 'spells'];
    allow create, update, delete: if isAdmin()
      && kind in ['classes', 'subclasses', 'species', 'backgrounds', 'feats', 'spells'];
  }
}

match /items/{itemId} {
  allow read: if true;
  allow write: if isAdmin();
}

// -----------------------------------------------------------------------
// PUBLIC PRODUCT CONFIG
// Readable by signed-in users so the UI can show the same limits enforced
// -----------------------------------------------------------------------
match /config/{configId} {
  allow read: if signedIn();
  allow create, update, delete: if isAdmin();
}

// -----------------------------------------------------------------------
// USERS
// IMPORTANT: users may NEVER grant themselves roles/capabilities.
// -----------------------------------------------------------------------
match /users/{userId} {
  allow read: if isSelf(userId) || isAdmin();

  // New accounts bootstrap under their real Auth UID as viewer only.
  allow create: if isSelf(userId)
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.emailLower == authEmailLower()
    && request.resource.data.role == ["viewer"];

  // Users can edit harmless profile fields only.
  allow update: if isAdmin()
    || (
      isSelf(userId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name",
        "photoURL",
        "settings",
        "updatedAt"
      ])
    );

  allow delete: if isAdmin();

  // DM-owned creature templates, separate from global SRD and campaign copies.
  match /creatureTemplates/{templateId} {
    function validTemplate(d) {
      return d.keys().hasOnly(['title','summary','content','data','sourceCampaignId','createdBy','createdAt','updatedAt'])
        && d.title is string && d.title.size() > 0 && d.title.size() <= 160
        && d.summary is string && d.summary.size() <= 1000
        && d.content is string && d.content.size() <= 20000
        && d.sourceCampaignId is string && d.sourceCampaignId.size() <= 100
        && d.data is map && d.data.keys().size() <= 60
        && d.createdBy == userId && d.createdAt is int && d.updatedAt is int;
    }
    allow read: if isSelf(userId);
    allow create: if isSelf(userId) && validTemplate(request.resource.data)
      && templateId.matches('^[a-zA-Z0-9_-]{1,100}
  // campaigns/{campaignId}/members/{uid} remains authoritative.
  match /campaigns/{campaignId} {
    allow read: if isSelf(userId);

    // campaign managers when changing a member role.
    allow create: if (
        validInviteUserIndexWrite(userId, campaignId)
      )
      || (
        isCampaignDM(campaignId)
        && request.resource.data.role in ["player", "dm"]
        && request.resource.data.status == "active"
      );
    allow update: if isCampaignDM(campaignId);
    allow delete: if isCampaignDM(campaignId);
  }
}

// -----------------------------------------------------------------------
// CAMPAIGN INVITATIONS
// Email is only a matching key. The authenticated UID becomes authoritative
// after acceptance, when membership + user index are written atomically.
// -----------------------------------------------------------------------
match /userDirectory/{uid} {
  allow read: if signedIn();
  allow create, update: if (isSelf(uid) || isAdmin())
    && request.resource.data.keys().hasOnly(["uid", "name", "emailHint", "updatedAt"])
    && request.resource.data.uid == uid
    && request.resource.data.name is string
    && request.resource.data.emailHint is string
    && request.resource.data.updatedAt is int;
  allow delete: if isSelf(uid) || isAdmin();
}

match /campaignInvites/{inviteId} {
  allow read: if inviteBelongsToCurrentUser(resource.data) || isCampaignDM(resource.data.campaignId);

  allow create: if signedIn()
    && request.resource.data.campaignId is string
    && isCampaignDM(request.resource.data.campaignId)
    && request.resource.data.name is string
    && request.resource.data.email is string
    && request.resource.data.emailLower is string
    && request.resource.data.emailLower == request.resource.data.email.lower()
    && (("targetUid" in request.resource.data && request.resource.data.targetUid is string && request.resource.data.targetUid != "") || request.resource.data.emailLower != "")
    && request.resource.data.role in ["player", "dm"]
    && request.resource.data.status == "pending"
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt is int;

  allow update: if (
      inviteBelongsToCurrentUser(resource.data)
      && resource.data.status == "pending"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.status == "declined"
      && request.resource.data.declinedBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "declinedBy",
        "declinedAt"
      ])
    )
    || (
      inviteBelongsToCurrentUser(resource.data)
      && resource.data.status == "pending"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.status == "accepted"
      && request.resource.data.acceptedBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "acceptedBy",
        "acceptedAt"
      ])
      && getAfter(memberPath(resource.data.campaignId, request.auth.uid)).data.status == "active"
      && getAfter(memberPath(resource.data.campaignId, request.auth.uid)).data.inviteId == inviteId
      && getAfter(userCampaignPath(request.auth.uid, resource.data.campaignId)).data.status == "active"
      && getAfter(userCampaignPath(request.auth.uid, resource.data.campaignId)).data.inviteId == inviteId
    )
    || (
      isCampaignDM(resource.data.campaignId)
      && resource.data.status == "pending"
      && request.resource.data.status == "canceled"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.canceledBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "canceledBy",
        "canceledAt"
      ])
    );

  allow delete: if isCampaignDM(resource.data.campaignId);
}

// -----------------------------------------------------------------------
// CAMPAIGNS
// -----------------------------------------------------------------------
match /campaigns/{campaignId} {
  // Players should discover campaign IDs through users/{uid}/campaigns,
  // then fetch only campaigns they belong to.
  allow read: if isCampaignOwner(campaignId)
    || isActiveMember(campaignId);

  allow create: if canCreateCampaigns()
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.dmId == request.auth.uid
    && request.resource.data.name is string;

  // Campaign DMs can edit normal campaign settings, but cannot transfer
  allow update: if isCampaignDM(campaignId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "description", "defaultItemVisible", "updatedAt", "inventoryVersion", "inventoryMigratedAt", "allowedEditions"])
    && request.resource.data.name is string
    && (!('allowedEditions' in request.resource.data) || (request.resource.data.allowedEditions is list && request.resource.data.allowedEditions.size() >= 1 && request.resource.data.allowedEditions.size() <= 2 && request.resource.data.allowedEditions.hasOnly(['2014', '2024']) && (request.resource.data.allowedEditions.size() == 1 || request.resource.data.allowedEditions.hasAll(['2014', '2024']))));
  allow delete: if isCampaignOwner(campaignId);

  // Connected campaign workspace. Public descriptions and private notes are separate.
  function workspaceCollection(kind) {
    return kind == 'world' ? 'worldEntries' : kind == 'creature' ? 'creatures' : kind == 'chapter' ? 'chapters' : kind == 'encounter' ? 'encounters' : 'oneShots';
  }
  function validWorkspace(d, kind) {
    return d.keys().hasOnly(['kind','schemaVersion','revision','title','summary','content','data','archived','createdBy','createdAt','updatedBy','updatedAt'])
      && d.keys().hasAll(['kind','schemaVersion','revision','title','summary','content','data','archived','createdBy','createdAt','updatedBy','updatedAt'])
      && d.kind == kind && d.schemaVersion == 1 && d.revision is int && d.revision > 0
      && d.title is string && d.title.size() > 0 && d.title.size() <= 160
      && d.summary is string && d.summary.size() <= 1000
      && d.content is string && d.content.size() <= 20000
      && d.data is map && d.data.keys().size() <= 60 && d.archived is bool
      && d.createdBy is string && d.createdAt is int && d.updatedAt is int
      && d.updatedBy == request.auth.uid;
  }
  match /{workspace}/{recordId} {
    function supported() { return workspace in ['worldEntries','creatures','chapters','encounters','oneShots']; }
    function kind() { return workspace == 'worldEntries' ? 'world' : workspace == 'creatures' ? 'creature' : workspace == 'chapters' ? 'chapter' : workspace == 'encounters' ? 'encounter' : 'oneShot'; }
    allow read: if supported() && isCampaignDM(campaignId);
    allow create: if supported() && workspace != 'oneShots' && isCampaignDM(campaignId) && validWorkspace(request.resource.data, kind())
      && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid;
    allow update: if supported() && workspace != 'oneShots' && isCampaignDM(campaignId) && validWorkspace(request.resource.data, kind())
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    // Archive retains IDs and related records. Hard deletion is intentionally unavailable.
  }
  function canReadShot(d) {
    return isCampaignDM(campaignId) || (isActiveMember(campaignId) && (d.createdBy == request.auth.uid || d.data.hostUid == request.auth.uid || request.auth.uid in d.data.participantUids));
  }
  function canPrepShot(d) {
    return isCampaignDM(campaignId) || (isActiveMember(campaignId) && ((d.data.approved && d.data.hostUid == request.auth.uid) || (!d.data.approved && d.createdBy == request.auth.uid)));
  }
  function validShot(d) {
    return validWorkspace(d, 'oneShot') && d.data.approved is bool && d.data.hostUid is string
      && d.data.participantUids is list && d.data.participantUids.size() <= 20
      && d.data.targetLevel is int && d.data.targetLevel >= 1 && d.data.targetLevel <= 20
      && d.data.rosterMode in ['DM pre-generated','Player-created','Mixed'];
  }
  match /oneShots/{shotId} {
    function parent() { return get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)).data; }
    function accepted() { return isActiveMember(campaignId) && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(request.auth.uid)) && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(request.auth.uid)).data.status == 'accepted' && request.auth.uid in parent().data.participantUids; }
    function manager() { return isCampaignDM(campaignId) || (isActiveMember(campaignId) && parent().data.approved && parent().data.hostUid == request.auth.uid); }
    allow get: if canReadShot(resource.data) || (isActiveMember(campaignId) && !exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)));
    allow list: if canReadShot(resource.data);
    allow create: if validShot(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid
      && (isCampaignDM(campaignId) || (isActiveMember(campaignId) && !request.resource.data.data.approved && request.resource.data.data.hostUid == '' && request.resource.data.data.participantUids.size() == 0));
    allow update: if validShot(request.resource.data) && canPrepShot(resource.data)
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
      && (isCampaignDM(campaignId) || (request.resource.data.data.approved == resource.data.data.approved && request.resource.data.data.hostUid == resource.data.data.hostUid && request.resource.data.data.participantUids == resource.data.data.participantUids && (request.resource.data.data.targetLevel == resource.data.data.targetLevel && request.resource.data.data.rosterMode == resource.data.data.rosterMode || !resource.data.data.approved && resource.data.createdBy == request.auth.uid) && request.resource.data.data.get('links',[]) == resource.data.data.get('links',[])));
    match /encounters/{encounterId} {
      allow read: if manager();
      allow create: if manager() && validWorkspace(request.resource.data, 'encounter') && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid;
      allow update: if manager() && validWorkspace(request.resource.data, 'encounter') && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /participants/{uid} {
      allow read: if manager() || (isActiveMember(campaignId) && uid == request.auth.uid);
      allow create: if isCampaignDM(campaignId) && request.resource.data.keys().hasOnly(['uid','status','invitedBy','updatedAt']) && request.resource.data.uid == uid && request.resource.data.status == 'invited' && request.resource.data.invitedBy == request.auth.uid && exists(memberPath(campaignId,uid)) && get(memberPath(campaignId,uid)).data.status == 'active';
      allow update: if isActiveMember(campaignId) && uid == request.auth.uid && uid in parent().data.participantUids && request.resource.data.status in ['accepted','declined'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    }
    match /rosterState/main {
      allow read: if manager() || accepted();
      allow create, update: if (manager() || accepted())
        && request.resource.data.keys().hasOnly(['count','lastCharacterId','updatedBy']) && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
        && ((!exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main) && request.resource.data.count == 1) || request.resource.data.count == resource.data.count + 1)
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(request.resource.data.lastCharacterId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(request.resource.data.lastCharacterId)).data.sequence == request.resource.data.count;
    }
    match /characters/{characterId} {
      function assigned(uid) { return uid == '' || (uid in parent().data.participantUids && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(uid)) && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(uid)).data.status == 'accepted'); }
      function validCharacter(d) { return d.keys().hasOnly(['name','class','level','userId','createdBy','createdAt','active','sequence']) && d.name is string && d.name.size() > 0 && d.name.size() <= 160 && d.class is string && d.class.size() <= 160 && d.level is int && d.level >= 1 && d.level <= parent().data.targetLevel && d.userId is string && d.active is bool && d.sequence is int; }
      allow read: if manager() || (accepted() && resource.data.userId == request.auth.uid);
      allow create: if validCharacter(request.resource.data) && request.resource.data.createdBy == request.auth.uid
        && ((manager() && assigned(request.resource.data.userId)) || (accepted() && parent().data.approved && parent().data.rosterMode in ['Player-created','Mixed'] && request.resource.data.userId == request.auth.uid))
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main).data.lastCharacterId == characterId
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main).data.count == request.resource.data.sequence;
      allow update: if validCharacter(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.sequence == resource.data.sequence
        && ((manager() && assigned(request.resource.data.userId)) || (accepted() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId));
    }
    match /characterSheets/{characterId} {
      function owns() { return accepted() && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(characterId)).data.userId == request.auth.uid; }
      function protectedGrant(data) { let grant=data.get('rulesChoices',{}).get('grants',{}).get('__dm',{});return [grant.get('bonusFeats',0),grant.get('bonusAsis',0),grant.get('usedAsis',0),data.get('advancement',{}).get('asiSpent',0)]; }
      function valid(d) { return d.keys().hasOnly(['schemaVersion','revision','data','updatedAt','updatedBy']) && d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 100 && d.revision is int && d.data is map && d.updatedBy == request.auth.uid && d.updatedAt is int && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(characterId)); }
      allow read: if manager() || owns();
      allow create: if (manager() || owns()) && valid(request.resource.data) && request.resource.data.revision == 1 && (manager() || protectedGrant(request.resource.data.data) == [0,0,0,0]);
      allow update: if (manager() || owns()) && valid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && (manager() || protectedGrant(request.resource.data.data) == protectedGrant(resource.data.data));
    }
  }
  match /workspaceSecrets/{secretId} {
    allow read: if isCampaignDM(campaignId) || (resource.data.kind == 'oneShot' && canPrepShot(get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(resource.data.recordId)).data));
    allow create, update: if (isCampaignDM(campaignId) || (request.resource.data.kind == 'oneShot' && canPrepShot(getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(request.resource.data.recordId)).data)))
      && request.resource.data.keys().hasOnly(['kind','recordId','notes','updatedBy','updatedAt'])
      && request.resource.data.kind in ['world','creature','chapter','encounter','oneShot']
      && request.resource.data.recordId is string
      && secretId == request.resource.data.kind + '-' + request.resource.data.recordId
      && request.resource.data.notes is string && request.resource.data.notes.size() <= 20000
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is int
      && existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/$(workspaceCollection(request.resource.data.kind))/$(request.resource.data.recordId));
  }

  // ---------------------------------------------------------------------
  // MEMBERS
  // ---------------------------------------------------------------------
  match /featCatalog/{featId} {
    allow read: if isCampaignDM(campaignId) || isActiveMember(campaignId);
    allow create, update: if isCampaignDM(campaignId)
      && featId.matches('^[a-zA-Z0-9_-]{1,100}$')
      && request.resource.data.keys().hasOnly(['name','description','edition','hidden','custom','minimumLevel','hpPerLevel','speedBonus','armorTraining'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
      && request.resource.data.description is string && request.resource.data.description.size() <= 12000
      && request.resource.data.edition in ['2014','2024']
      && request.resource.data.hidden is bool && request.resource.data.custom is bool
      && request.resource.data.minimumLevel is int && request.resource.data.minimumLevel >= 0 && request.resource.data.minimumLevel <= 20
      && request.resource.data.hpPerLevel is int && request.resource.data.hpPerLevel >= 0 && request.resource.data.hpPerLevel <= 10
      && request.resource.data.speedBonus is int && request.resource.data.speedBonus >= 0 && request.resource.data.speedBonus <= 60
      && request.resource.data.armorTraining is list && request.resource.data.armorTraining.size() <= 4 && request.resource.data.armorTraining.hasOnly(['light','medium','heavy','shield']);
    allow delete: if isCampaignDM(campaignId);
  }
  match /members/{uid} {
    // Active campaign members may see the roster; an invited user may
    // read their own membership record.
    allow read: if isCampaignDM(campaignId)
      || isActiveMember(campaignId)
      || isSelf(uid);

    // Campaign DMs manage member roles and statuses.
    allow create: if validInviteMembershipWrite(campaignId, uid)
      || (isCampaignDM(campaignId) && validMemberData(uid));
    allow update: if isCampaignDM(campaignId) && validMemberData(uid);
    allow delete: if isCampaignDM(campaignId);
  }

  // ---------------------------------------------------------------------

// CHARACTERS
// Active campaign members may create and manage their own characters.
// Campaign DMs may manage all characters.
// ---------------------------------------------------------------------
match /characters/{charId} {
  allow read: if isCampaignDM(campaignId) || isActiveMember(campaignId);
  allow create: if (
      ((isActiveMember(campaignId) || isCampaignOwner(campaignId))
        && request.resource.data.userId == request.auth.uid)
      || (
        isCampaignDM(campaignId)
        && request.resource.data.userId is string
        && exists(memberPath(campaignId, request.resource.data.userId))
        && get(memberPath(campaignId, request.resource.data.userId)).data.status == "active"
      )
    );
  allow update: if request.resource.data.userId == resource.data.userId
    && (isCampaignDM(campaignId) || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid));
  allow delete: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid);
}
// Private character details are separate from the campaign's shared roster.
match /characterSheets/{charId} {
  function mayUseSheet() {
    return isCampaignDM(campaignId)
      || (isActiveMember(campaignId)
        && get(characterPath(campaignId, charId)).data.userId == request.auth.uid);
  }
  function protectedAdvancement(data) {
    let grant = data.get('rulesChoices', {}).get('grants', {}).get('__dm', {});
    return [grant.get('bonusFeats', 0), grant.get('bonusAsis', 0), grant.get('usedAsis', 0), data.get('advancement', {}).get('asiSpent', 0)];
  }
  function validSheet() {
    let d = request.resource.data;
    // Security rules protect who may write and the stable document envelope.
    // Character-sheet content evolves frequently (tabs, companions, rules pages,
    // class data, inventory, etc.) and is normalized/versioned by the application.
    // Do not duplicate that fast-moving content schema here: doing so turns every
    // legitimate new sheet field into a false "Missing or insufficient permissions".
    return exists(characterPath(campaignId, charId))
      && d.keys().hasOnly(['schemaVersion','revision','data','updatedAt','updatedBy'])
      && d.schemaVersion is int
      && d.schemaVersion >= 1
      && d.schemaVersion <= 100
      && d.revision is int
      && d.revision > 0
      && d.updatedBy == request.auth.uid
      && d.updatedAt is int
      && d.data is map;
  }
  allow get: if mayUseSheet();
  allow list: if false;
  allow create: if mayUseSheet() && validSheet() && request.resource.data.revision == 1
    && (isCampaignDM(campaignId) || protectedAdvancement(request.resource.data.data) == [0,0,0,0]);
  allow update: if mayUseSheet() && validSheet()
    && request.resource.data.schemaVersion >= resource.data.schemaVersion
    && request.resource.data.revision == resource.data.revision + 1
    && (isCampaignDM(campaignId) || protectedAdvancement(request.resource.data.data) == protectedAdvancement(resource.data.data));
  allow delete: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId)
      && exists(characterPath(campaignId, charId))
      && get(characterPath(campaignId, charId)).data.userId == request.auth.uid);
}
match /saves/{saveId} {
  allow read: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid);
  allow create: if (isActiveMember(campaignId) || isCampaignOwner(campaignId))
    && request.resource.data.keys().hasOnly(["itemId", "characterId", "userId", "created"])
    && request.resource.data.userId == request.auth.uid
    && saveCharacterBelongsTo(campaignId, request.resource.data, request.auth.uid)
    && saveId == request.resource.data.characterId + "__" + request.resource.data.itemId
    && get(/databases/$(database)/documents/campaigns/$(campaignId)/items/$(request.resource.data.itemId)).data.visible == true;
  allow update: if false;
  allow delete: if isCampaignDM(campaignId)
    || ((isActiveMember(campaignId) || isCampaignOwner(campaignId)) && resource.data.userId == request.auth.uid);
}
function itemPath(itemId) { return /databases/$(database)/documents/campaigns/$(campaignId)/items/$(itemId); }
function stockPath(itemId) { return /databases/$(database)/documents/campaigns/$(campaignId)/supply/$(itemId); }
function inventoryPath(entryId) { return /databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(entryId); }
function ownInventory(data) { return isActiveMember(campaignId) && data.userId == request.auth.uid; }
function validInventory(data, entryId) {
 return data.keys().hasOnly(['itemId','characterId','userId','quantity','item','campaignId','receivedAt','updatedAt'])
 && data.campaignId == campaignId && data.itemId is string && data.characterId is string
 && entryId == data.characterId + '__' + data.itemId
 && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
 && data.item is map && data.receivedAt is int && data.updatedAt is int
 && get(characterPath(campaignId,data.characterId)).data.userId == data.userId;
}
function claimCredit(data,entryId,previous) {
 let stock = get(stockPath(data.itemId)).data;
 let after = getAfter(stockPath(data.itemId)).data;
 let item = get(itemPath(data.itemId)).data;
 return ownInventory(data) && validInventory(data,entryId)
 && get(campaignPath(campaignId)).data.inventoryVersion == 2
 && get(characterPath(campaignId,data.characterId)).data.get('active',true) != false
 && item.visible == true && item.lootMode == 'player' && data.item == item
 && data.quantity > previous
 && after.lastClaim.entryId == entryId && after.lastClaim.actorId == request.auth.uid
 && after.lastClaim.quantity == data.quantity - previous
 && after.claimed == stock.claimed + data.quantity - previous
 && after.revision == stock.revision + 1;
}
function debitMatches(itemId) {
 let d = request.resource.data;
 let path = inventoryPath(d.lastClaim.entryId);
 let after = getAfter(path).data;
 let previous = exists(path) ? get(path).data.quantity : 0;
 return isActiveMember(campaignId)
 && d.diff(resource.data).affectedKeys().hasOnly(['claimed','revision','lastClaim','updatedAt'])
 && d.lastClaim.keys().hasOnly(['entryId','actorId','quantity'])
 && d.lastClaim.actorId == request.auth.uid
 && d.lastClaim.quantity is int && d.lastClaim.quantity > 0
 && d.claimed == resource.data.claimed + d.lastClaim.quantity
 && d.revision == resource.data.revision + 1
 && after.userId == request.auth.uid && after.itemId == itemId
 && after.quantity == previous + d.lastClaim.quantity;
}
function validStock(d) {
 return d.keys().hasOnly(['capacity','claimed','unlimited','revision','lastClaim','updatedAt'])
 && d.capacity is int && d.capacity >= 0
 && d.claimed is int && d.claimed >= 0
 && d.unlimited is bool && (d.unlimited || d.claimed <= d.capacity)
 && d.revision is int && d.revision > 0 && d.updatedAt is int;
}
match /items/{itemId} {
 allow read: if isCampaignDM(campaignId) || (isActiveMember(campaignId) && resource.data.visible == true);
 allow create, update: if isCampaignDM(campaignId)
 && request.resource.data.campaignId == campaignId
 && request.resource.data.visible is bool && request.resource.data.highlighted is bool
 && request.resource.data.name is string && request.resource.data.lootMode in ['player','dm'];
 allow delete: if isCampaignDM(campaignId);
}
match /supply/{itemId} {
 allow read: if isCampaignDM(campaignId)
   || (isActiveMember(campaignId)
     && exists(itemPath(itemId))
     && get(itemPath(itemId)).data.visible == true
     && get(itemPath(itemId)).data.lootMode == 'player');
 allow create: if isCampaignDM(campaignId) && validStock(request.resource.data);
 allow update: if validStock(request.resource.data) && (isCampaignDM(campaignId) || debitMatches(itemId));
 allow delete: if isCampaignDM(campaignId);
}
match /inventory/{entryId} {
 allow get: if isCampaignDM(campaignId) || (isActiveMember(campaignId) && (!exists(inventoryPath(entryId)) || resource.data.userId == request.auth.uid));
 allow list: if isCampaignDM(campaignId) || ownInventory(resource.data);
 allow create: if (isCampaignDM(campaignId) && validInventory(request.resource.data,entryId)) || claimCredit(request.resource.data,entryId,0);
 allow update: if (isCampaignDM(campaignId) && validInventory(request.resource.data,entryId))
 || (ownInventory(resource.data)
   && request.resource.data.userId == resource.data.userId
   && request.resource.data.characterId == resource.data.characterId
   && request.resource.data.itemId == resource.data.itemId
   && request.resource.data.receivedAt == resource.data.receivedAt
   && (claimCredit(request.resource.data,entryId,resource.data.quantity)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity','updatedAt'])
       && request.resource.data.quantity is int && request.resource.data.quantity > 0
       && request.resource.data.quantity < resource.data.quantity)));
 allow delete: if isCampaignDM(campaignId) || ownInventory(resource.data);
}
match /migrationNotes/{itemId} {
 allow read, write: if isCampaignDM(campaignId);
}
// Legacy records remain available to the DM for migration/audit only.
match /itemState/{itemId} {
  allow read: if isCampaignDM(campaignId);
  allow write: if false;
}
match /itemVisibility/{itemId} {
  allow read: if isCampaignDM(campaignId);
  allow write: if false;
}
}

// -----------------------------------------------------------------------
// DM REQUESTS — roadmap Step 4
//
// Global DM approval only grants campaign-creation capability.
// Campaign authority is still controlled by campaign membership/ownership.
// -----------------------------------------------------------------------
match /dmRequests/{uid} {
  allow read: if isSelf(uid) || isAdmin();

  // A signed-in user may submit exactly one application under their own UID.
  // Email is matched to the authenticated account, but email verification is
  // intentionally NOT required in the current closed/testing product flow.
  allow create: if isSelf(uid)
    && hasAuthEmail()
    && request.resource.data.keys().hasAll([
      "userId",
      "name",
      "email",
      "emailLower",
      "message",
      "experience",
      "status",
      "submittedAt",
      "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "userId",
      "name",
      "email",
      "emailLower",
      "message",
      "experience",
      "status",
      "submittedAt",
      "updatedAt"
    ])
    && request.resource.data.userId == uid
    && request.resource.data.name is string
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.emailLower == authEmailLower()
    && request.resource.data.message is string
    && request.resource.data.experience is string
    && request.resource.data.status == "pending"
    && request.resource.data.submittedAt is int
    && request.resource.data.updatedAt is int;

  // Applicants may only withdraw a pending application or re-submit a
  // rejected/withdrawn/revoked application. They cannot alter reviewer data.
  allow update: if (
      isSelf(uid)
      && resource.data.userId == uid
      && request.resource.data.userId == uid
      && request.resource.data.email == resource.data.email
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.emailLower == authEmailLower()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name",
        "message",
        "experience",
        "status",
        "submittedAt",
        "updatedAt"
      ])
      && (
        (
          resource.data.status == "pending"
          && request.resource.data.status == "withdrawn"
        )
        ||
        (
          resource.data.status in ["rejected", "withdrawn", "revoked"]
          && request.resource.data.status == "pending"
        )
      )
    )
    || (
      isAdmin()
      && request.resource.data.userId == resource.data.userId
      && request.resource.data.status in [
        "pending",
        "approved",
        "rejected",
        "withdrawn",
        "revoked"
      ]
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "reviewedAt",
        "reviewedBy",
        "reviewNote",
        "updatedAt"
      ])
    );

  allow delete: if isAdmin();
}

// -----------------------------------------------------------------------
// LEGACY GLOBAL COLLECTIONS
// Keep admin-readable only while migration is being verified.
// Delete these collections and these rules afterwards.
// -----------------------------------------------------------------------
match /characters/{charId} {
  allow read: if isAdmin();
  allow write: if false;
}

match /wishes/{wishId} {
  allow read: if isAdmin();
  allow write: if false;
}

// Everything else is denied by default.

}
}
);
    allow update: if isSelf(userId) && validTemplate(request.resource.data)
      && request.resource.data.createdAt == resource.data.createdAt;
    allow delete: if isSelf(userId);
  }

  // Fast campaign lookup index. This is NOT authoritative permission;
  // campaigns/{campaignId}/members/{uid} remains authoritative.
  match /campaigns/{campaignId} {
    allow read: if isSelf(userId);

    // campaign managers when changing a member role.
    allow create: if (
        validInviteUserIndexWrite(userId, campaignId)
      )
      || (
        isCampaignDM(campaignId)
        && request.resource.data.role in ["player", "dm"]
        && request.resource.data.status == "active"
      );
    allow update: if isCampaignDM(campaignId);
    allow delete: if isCampaignDM(campaignId);
  }
}

// -----------------------------------------------------------------------
// CAMPAIGN INVITATIONS
// Email is only a matching key. The authenticated UID becomes authoritative
// after acceptance, when membership + user index are written atomically.
// -----------------------------------------------------------------------
match /userDirectory/{uid} {
  allow read: if signedIn();
  allow create, update: if (isSelf(uid) || isAdmin())
    && request.resource.data.keys().hasOnly(["uid", "name", "emailHint", "updatedAt"])
    && request.resource.data.uid == uid
    && request.resource.data.name is string
    && request.resource.data.emailHint is string
    && request.resource.data.updatedAt is int;
  allow delete: if isSelf(uid) || isAdmin();
}

match /campaignInvites/{inviteId} {
  allow read: if inviteBelongsToCurrentUser(resource.data) || isCampaignDM(resource.data.campaignId);

  allow create: if signedIn()
    && request.resource.data.campaignId is string
    && isCampaignDM(request.resource.data.campaignId)
    && request.resource.data.name is string
    && request.resource.data.email is string
    && request.resource.data.emailLower is string
    && request.resource.data.emailLower == request.resource.data.email.lower()
    && (("targetUid" in request.resource.data && request.resource.data.targetUid is string && request.resource.data.targetUid != "") || request.resource.data.emailLower != "")
    && request.resource.data.role in ["player", "dm"]
    && request.resource.data.status == "pending"
    && request.resource.data.createdBy == request.auth.uid
    && request.resource.data.createdAt is int;

  allow update: if (
      inviteBelongsToCurrentUser(resource.data)
      && resource.data.status == "pending"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.status == "declined"
      && request.resource.data.declinedBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "declinedBy",
        "declinedAt"
      ])
    )
    || (
      inviteBelongsToCurrentUser(resource.data)
      && resource.data.status == "pending"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.status == "accepted"
      && request.resource.data.acceptedBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "acceptedBy",
        "acceptedAt"
      ])
      && getAfter(memberPath(resource.data.campaignId, request.auth.uid)).data.status == "active"
      && getAfter(memberPath(resource.data.campaignId, request.auth.uid)).data.inviteId == inviteId
      && getAfter(userCampaignPath(request.auth.uid, resource.data.campaignId)).data.status == "active"
      && getAfter(userCampaignPath(request.auth.uid, resource.data.campaignId)).data.inviteId == inviteId
    )
    || (
      isCampaignDM(resource.data.campaignId)
      && resource.data.status == "pending"
      && request.resource.data.status == "canceled"
      && request.resource.data.campaignId == resource.data.campaignId
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.role == resource.data.role
      && request.resource.data.canceledBy == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "canceledBy",
        "canceledAt"
      ])
    );

  allow delete: if isCampaignDM(resource.data.campaignId);
}

// -----------------------------------------------------------------------
// CAMPAIGNS
// -----------------------------------------------------------------------
match /campaigns/{campaignId} {
  // Players should discover campaign IDs through users/{uid}/campaigns,
  // then fetch only campaigns they belong to.
  allow read: if isCampaignOwner(campaignId)
    || isActiveMember(campaignId);

  allow create: if canCreateCampaigns()
    && request.resource.data.ownerId == request.auth.uid
    && request.resource.data.dmId == request.auth.uid
    && request.resource.data.name is string;

  // Campaign DMs can edit normal campaign settings, but cannot transfer
  allow update: if isCampaignDM(campaignId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["name", "description", "defaultItemVisible", "updatedAt", "inventoryVersion", "inventoryMigratedAt", "allowedEditions"])
    && request.resource.data.name is string
    && (!('allowedEditions' in request.resource.data) || (request.resource.data.allowedEditions is list && request.resource.data.allowedEditions.size() >= 1 && request.resource.data.allowedEditions.size() <= 2 && request.resource.data.allowedEditions.hasOnly(['2014', '2024']) && (request.resource.data.allowedEditions.size() == 1 || request.resource.data.allowedEditions.hasAll(['2014', '2024']))));
  allow delete: if isCampaignOwner(campaignId);

  // Connected campaign workspace. Public descriptions and private notes are separate.
  function workspaceCollection(kind) {
    return kind == 'world' ? 'worldEntries' : kind == 'creature' ? 'creatures' : kind == 'chapter' ? 'chapters' : kind == 'encounter' ? 'encounters' : 'oneShots';
  }
  function validWorkspace(d, kind) {
    return d.keys().hasOnly(['kind','schemaVersion','revision','title','summary','content','data','archived','createdBy','createdAt','updatedBy','updatedAt'])
      && d.keys().hasAll(['kind','schemaVersion','revision','title','summary','content','data','archived','createdBy','createdAt','updatedBy','updatedAt'])
      && d.kind == kind && d.schemaVersion == 1 && d.revision is int && d.revision > 0
      && d.title is string && d.title.size() > 0 && d.title.size() <= 160
      && d.summary is string && d.summary.size() <= 1000
      && d.content is string && d.content.size() <= 20000
      && d.data is map && d.data.keys().size() <= 60 && d.archived is bool
      && d.createdBy is string && d.createdAt is int && d.updatedAt is int
      && d.updatedBy == request.auth.uid;
  }
  match /{workspace}/{recordId} {
    function supported() { return workspace in ['worldEntries','creatures','chapters','encounters','oneShots']; }
    function kind() { return workspace == 'worldEntries' ? 'world' : workspace == 'creatures' ? 'creature' : workspace == 'chapters' ? 'chapter' : workspace == 'encounters' ? 'encounter' : 'oneShot'; }
    allow read: if supported() && isCampaignDM(campaignId);
    allow create: if supported() && workspace != 'oneShots' && isCampaignDM(campaignId) && validWorkspace(request.resource.data, kind())
      && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid;
    allow update: if supported() && workspace != 'oneShots' && isCampaignDM(campaignId) && validWorkspace(request.resource.data, kind())
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    // Archive retains IDs and related records. Hard deletion is intentionally unavailable.
  }
  function canReadShot(d) {
    return isCampaignDM(campaignId) || (isActiveMember(campaignId) && (d.createdBy == request.auth.uid || d.data.hostUid == request.auth.uid || request.auth.uid in d.data.participantUids));
  }
  function canPrepShot(d) {
    return isCampaignDM(campaignId) || (isActiveMember(campaignId) && ((d.data.approved && d.data.hostUid == request.auth.uid) || (!d.data.approved && d.createdBy == request.auth.uid)));
  }
  function validShot(d) {
    return validWorkspace(d, 'oneShot') && d.data.approved is bool && d.data.hostUid is string
      && d.data.participantUids is list && d.data.participantUids.size() <= 20
      && d.data.targetLevel is int && d.data.targetLevel >= 1 && d.data.targetLevel <= 20
      && d.data.rosterMode in ['DM pre-generated','Player-created','Mixed'];
  }
  match /oneShots/{shotId} {
    function parent() { return get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)).data; }
    function accepted() { return isActiveMember(campaignId) && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(request.auth.uid)) && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(request.auth.uid)).data.status == 'accepted' && request.auth.uid in parent().data.participantUids; }
    function manager() { return isCampaignDM(campaignId) || (isActiveMember(campaignId) && parent().data.approved && parent().data.hostUid == request.auth.uid); }
    allow get: if canReadShot(resource.data) || (isActiveMember(campaignId) && !exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)));
    allow list: if canReadShot(resource.data);
    allow create: if validShot(request.resource.data) && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid
      && (isCampaignDM(campaignId) || (isActiveMember(campaignId) && !request.resource.data.data.approved && request.resource.data.data.hostUid == '' && request.resource.data.data.participantUids.size() == 0));
    allow update: if validShot(request.resource.data) && canPrepShot(resource.data)
      && request.resource.data.revision == resource.data.revision + 1
      && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt
      && (isCampaignDM(campaignId) || (request.resource.data.data.approved == resource.data.data.approved && request.resource.data.data.hostUid == resource.data.data.hostUid && request.resource.data.data.participantUids == resource.data.data.participantUids && (request.resource.data.data.targetLevel == resource.data.data.targetLevel && request.resource.data.data.rosterMode == resource.data.data.rosterMode || !resource.data.data.approved && resource.data.createdBy == request.auth.uid) && request.resource.data.data.get('links',[]) == resource.data.data.get('links',[])));
    match /encounters/{encounterId} {
      allow read: if manager();
      allow create: if manager() && validWorkspace(request.resource.data, 'encounter') && request.resource.data.revision == 1 && request.resource.data.createdBy == request.auth.uid;
      allow update: if manager() && validWorkspace(request.resource.data, 'encounter') && request.resource.data.revision == resource.data.revision + 1 && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt;
    }
    match /participants/{uid} {
      allow read: if manager() || (isActiveMember(campaignId) && uid == request.auth.uid);
      allow create: if isCampaignDM(campaignId) && request.resource.data.keys().hasOnly(['uid','status','invitedBy','updatedAt']) && request.resource.data.uid == uid && request.resource.data.status == 'invited' && request.resource.data.invitedBy == request.auth.uid && exists(memberPath(campaignId,uid)) && get(memberPath(campaignId,uid)).data.status == 'active';
      allow update: if isActiveMember(campaignId) && uid == request.auth.uid && uid in parent().data.participantUids && request.resource.data.status in ['accepted','declined'] && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt']);
    }
    match /rosterState/main {
      allow read: if manager() || accepted();
      allow create, update: if (manager() || accepted())
        && request.resource.data.keys().hasOnly(['count','lastCharacterId','updatedBy']) && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.count is int && request.resource.data.count >= 1 && request.resource.data.count <= 20
        && ((!exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main) && request.resource.data.count == 1) || request.resource.data.count == resource.data.count + 1)
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(request.resource.data.lastCharacterId)).data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(request.resource.data.lastCharacterId)).data.sequence == request.resource.data.count;
    }
    match /characters/{characterId} {
      function assigned(uid) { return uid == '' || (uid in parent().data.participantUids && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(uid)) && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/participants/$(uid)).data.status == 'accepted'); }
      function validCharacter(d) { return d.keys().hasOnly(['name','class','level','userId','createdBy','createdAt','active','sequence']) && d.name is string && d.name.size() > 0 && d.name.size() <= 160 && d.class is string && d.class.size() <= 160 && d.level is int && d.level >= 1 && d.level <= parent().data.targetLevel && d.userId is string && d.active is bool && d.sequence is int; }
      allow read: if manager() || (accepted() && resource.data.userId == request.auth.uid);
      allow create: if validCharacter(request.resource.data) && request.resource.data.createdBy == request.auth.uid
        && ((manager() && assigned(request.resource.data.userId)) || (accepted() && parent().data.approved && parent().data.rosterMode in ['Player-created','Mixed'] && request.resource.data.userId == request.auth.uid))
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main).data.lastCharacterId == characterId
        && getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/rosterState/main).data.count == request.resource.data.sequence;
      allow update: if validCharacter(request.resource.data) && request.resource.data.createdBy == resource.data.createdBy && request.resource.data.createdAt == resource.data.createdAt && request.resource.data.sequence == resource.data.sequence
        && ((manager() && assigned(request.resource.data.userId)) || (accepted() && resource.data.userId == request.auth.uid && request.resource.data.userId == resource.data.userId));
    }
    match /characterSheets/{characterId} {
      function owns() { return accepted() && get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(characterId)).data.userId == request.auth.uid; }
      function protectedGrant(data) { let grant=data.get('rulesChoices',{}).get('grants',{}).get('__dm',{});return [grant.get('bonusFeats',0),grant.get('bonusAsis',0),grant.get('usedAsis',0),data.get('advancement',{}).get('asiSpent',0)]; }
      function valid(d) { return d.keys().hasOnly(['schemaVersion','revision','data','updatedAt','updatedBy']) && d.schemaVersion is int && d.schemaVersion >= 1 && d.schemaVersion <= 100 && d.revision is int && d.data is map && d.updatedBy == request.auth.uid && d.updatedAt is int && exists(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(shotId)/characters/$(characterId)); }
      allow read: if manager() || owns();
      allow create: if (manager() || owns()) && valid(request.resource.data) && request.resource.data.revision == 1 && (manager() || protectedGrant(request.resource.data.data) == [0,0,0,0]);
      allow update: if (manager() || owns()) && valid(request.resource.data) && request.resource.data.revision == resource.data.revision + 1 && (manager() || protectedGrant(request.resource.data.data) == protectedGrant(resource.data.data));
    }
  }
  match /workspaceSecrets/{secretId} {
    allow read: if isCampaignDM(campaignId) || (resource.data.kind == 'oneShot' && canPrepShot(get(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(resource.data.recordId)).data));
    allow create, update: if (isCampaignDM(campaignId) || (request.resource.data.kind == 'oneShot' && canPrepShot(getAfter(/databases/$(database)/documents/campaigns/$(campaignId)/oneShots/$(request.resource.data.recordId)).data)))
      && request.resource.data.keys().hasOnly(['kind','recordId','notes','updatedBy','updatedAt'])
      && request.resource.data.kind in ['world','creature','chapter','encounter','oneShot']
      && request.resource.data.recordId is string
      && secretId == request.resource.data.kind + '-' + request.resource.data.recordId
      && request.resource.data.notes is string && request.resource.data.notes.size() <= 20000
      && request.resource.data.updatedBy == request.auth.uid && request.resource.data.updatedAt is int
      && existsAfter(/databases/$(database)/documents/campaigns/$(campaignId)/$(workspaceCollection(request.resource.data.kind))/$(request.resource.data.recordId));
  }

  // ---------------------------------------------------------------------
  // MEMBERS
  // ---------------------------------------------------------------------
  match /featCatalog/{featId} {
    allow read: if isCampaignDM(campaignId) || isActiveMember(campaignId);
    allow create, update: if isCampaignDM(campaignId)
      && featId.matches('^[a-zA-Z0-9_-]{1,100}$')
      && request.resource.data.keys().hasOnly(['name','description','edition','hidden','custom','minimumLevel','hpPerLevel','speedBonus','armorTraining'])
      && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
      && request.resource.data.description is string && request.resource.data.description.size() <= 12000
      && request.resource.data.edition in ['2014','2024']
      && request.resource.data.hidden is bool && request.resource.data.custom is bool
      && request.resource.data.minimumLevel is int && request.resource.data.minimumLevel >= 0 && request.resource.data.minimumLevel <= 20
      && request.resource.data.hpPerLevel is int && request.resource.data.hpPerLevel >= 0 && request.resource.data.hpPerLevel <= 10
      && request.resource.data.speedBonus is int && request.resource.data.speedBonus >= 0 && request.resource.data.speedBonus <= 60
      && request.resource.data.armorTraining is list && request.resource.data.armorTraining.size() <= 4 && request.resource.data.armorTraining.hasOnly(['light','medium','heavy','shield']);
    allow delete: if isCampaignDM(campaignId);
  }
  match /members/{uid} {
    // Active campaign members may see the roster; an invited user may
    // read their own membership record.
    allow read: if isCampaignDM(campaignId)
      || isActiveMember(campaignId)
      || isSelf(uid);

    // Campaign DMs manage member roles and statuses.
    allow create: if validInviteMembershipWrite(campaignId, uid)
      || (isCampaignDM(campaignId) && validMemberData(uid));
    allow update: if isCampaignDM(campaignId) && validMemberData(uid);
    allow delete: if isCampaignDM(campaignId);
  }

  // ---------------------------------------------------------------------

// CHARACTERS
// Active campaign members may create and manage their own characters.
// Campaign DMs may manage all characters.
// ---------------------------------------------------------------------
match /characters/{charId} {
  allow read: if isCampaignDM(campaignId) || isActiveMember(campaignId);
  allow create: if (
      ((isActiveMember(campaignId) || isCampaignOwner(campaignId))
        && request.resource.data.userId == request.auth.uid)
      || (
        isCampaignDM(campaignId)
        && request.resource.data.userId is string
        && exists(memberPath(campaignId, request.resource.data.userId))
        && get(memberPath(campaignId, request.resource.data.userId)).data.status == "active"
      )
    );
  allow update: if request.resource.data.userId == resource.data.userId
    && (isCampaignDM(campaignId) || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid));
  allow delete: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid);
}
// Private character details are separate from the campaign's shared roster.
match /characterSheets/{charId} {
  function mayUseSheet() {
    return isCampaignDM(campaignId)
      || (isActiveMember(campaignId)
        && get(characterPath(campaignId, charId)).data.userId == request.auth.uid);
  }
  function protectedAdvancement(data) {
    let grant = data.get('rulesChoices', {}).get('grants', {}).get('__dm', {});
    return [grant.get('bonusFeats', 0), grant.get('bonusAsis', 0), grant.get('usedAsis', 0), data.get('advancement', {}).get('asiSpent', 0)];
  }
  function validSheet() {
    let d = request.resource.data;
    // Security rules protect who may write and the stable document envelope.
    // Character-sheet content evolves frequently (tabs, companions, rules pages,
    // class data, inventory, etc.) and is normalized/versioned by the application.
    // Do not duplicate that fast-moving content schema here: doing so turns every
    // legitimate new sheet field into a false "Missing or insufficient permissions".
    return exists(characterPath(campaignId, charId))
      && d.keys().hasOnly(['schemaVersion','revision','data','updatedAt','updatedBy'])
      && d.schemaVersion is int
      && d.schemaVersion >= 1
      && d.schemaVersion <= 100
      && d.revision is int
      && d.revision > 0
      && d.updatedBy == request.auth.uid
      && d.updatedAt is int
      && d.data is map;
  }
  allow get: if mayUseSheet();
  allow list: if false;
  allow create: if mayUseSheet() && validSheet() && request.resource.data.revision == 1
    && (isCampaignDM(campaignId) || protectedAdvancement(request.resource.data.data) == [0,0,0,0]);
  allow update: if mayUseSheet() && validSheet()
    && request.resource.data.schemaVersion >= resource.data.schemaVersion
    && request.resource.data.revision == resource.data.revision + 1
    && (isCampaignDM(campaignId) || protectedAdvancement(request.resource.data.data) == protectedAdvancement(resource.data.data));
  allow delete: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId)
      && exists(characterPath(campaignId, charId))
      && get(characterPath(campaignId, charId)).data.userId == request.auth.uid);
}
match /saves/{saveId} {
  allow read: if isCampaignDM(campaignId)
    || (isActiveMember(campaignId) && resource.data.userId == request.auth.uid);
  allow create: if (isActiveMember(campaignId) || isCampaignOwner(campaignId))
    && request.resource.data.keys().hasOnly(["itemId", "characterId", "userId", "created"])
    && request.resource.data.userId == request.auth.uid
    && saveCharacterBelongsTo(campaignId, request.resource.data, request.auth.uid)
    && saveId == request.resource.data.characterId + "__" + request.resource.data.itemId
    && get(/databases/$(database)/documents/campaigns/$(campaignId)/items/$(request.resource.data.itemId)).data.visible == true;
  allow update: if false;
  allow delete: if isCampaignDM(campaignId)
    || ((isActiveMember(campaignId) || isCampaignOwner(campaignId)) && resource.data.userId == request.auth.uid);
}
function itemPath(itemId) { return /databases/$(database)/documents/campaigns/$(campaignId)/items/$(itemId); }
function stockPath(itemId) { return /databases/$(database)/documents/campaigns/$(campaignId)/supply/$(itemId); }
function inventoryPath(entryId) { return /databases/$(database)/documents/campaigns/$(campaignId)/inventory/$(entryId); }
function ownInventory(data) { return isActiveMember(campaignId) && data.userId == request.auth.uid; }
function validInventory(data, entryId) {
 return data.keys().hasOnly(['itemId','characterId','userId','quantity','item','campaignId','receivedAt','updatedAt'])
 && data.campaignId == campaignId && data.itemId is string && data.characterId is string
 && entryId == data.characterId + '__' + data.itemId
 && data.quantity is int && data.quantity > 0 && data.quantity <= 1000000
 && data.item is map && data.receivedAt is int && data.updatedAt is int
 && get(characterPath(campaignId,data.characterId)).data.userId == data.userId;
}
function claimCredit(data,entryId,previous) {
 let stock = get(stockPath(data.itemId)).data;
 let after = getAfter(stockPath(data.itemId)).data;
 let item = get(itemPath(data.itemId)).data;
 return ownInventory(data) && validInventory(data,entryId)
 && get(campaignPath(campaignId)).data.inventoryVersion == 2
 && get(characterPath(campaignId,data.characterId)).data.get('active',true) != false
 && item.visible == true && item.lootMode == 'player' && data.item == item
 && data.quantity > previous
 && after.lastClaim.entryId == entryId && after.lastClaim.actorId == request.auth.uid
 && after.lastClaim.quantity == data.quantity - previous
 && after.claimed == stock.claimed + data.quantity - previous
 && after.revision == stock.revision + 1;
}
function debitMatches(itemId) {
 let d = request.resource.data;
 let path = inventoryPath(d.lastClaim.entryId);
 let after = getAfter(path).data;
 let previous = exists(path) ? get(path).data.quantity : 0;
 return isActiveMember(campaignId)
 && d.diff(resource.data).affectedKeys().hasOnly(['claimed','revision','lastClaim','updatedAt'])
 && d.lastClaim.keys().hasOnly(['entryId','actorId','quantity'])
 && d.lastClaim.actorId == request.auth.uid
 && d.lastClaim.quantity is int && d.lastClaim.quantity > 0
 && d.claimed == resource.data.claimed + d.lastClaim.quantity
 && d.revision == resource.data.revision + 1
 && after.userId == request.auth.uid && after.itemId == itemId
 && after.quantity == previous + d.lastClaim.quantity;
}
function validStock(d) {
 return d.keys().hasOnly(['capacity','claimed','unlimited','revision','lastClaim','updatedAt'])
 && d.capacity is int && d.capacity >= 0
 && d.claimed is int && d.claimed >= 0
 && d.unlimited is bool && (d.unlimited || d.claimed <= d.capacity)
 && d.revision is int && d.revision > 0 && d.updatedAt is int;
}
match /items/{itemId} {
 allow read: if isCampaignDM(campaignId) || (isActiveMember(campaignId) && resource.data.visible == true);
 allow create, update: if isCampaignDM(campaignId)
 && request.resource.data.campaignId == campaignId
 && request.resource.data.visible is bool && request.resource.data.highlighted is bool
 && request.resource.data.name is string && request.resource.data.lootMode in ['player','dm'];
 allow delete: if isCampaignDM(campaignId);
}
match /supply/{itemId} {
 allow read: if isCampaignDM(campaignId)
   || (isActiveMember(campaignId)
     && exists(itemPath(itemId))
     && get(itemPath(itemId)).data.visible == true
     && get(itemPath(itemId)).data.lootMode == 'player');
 allow create: if isCampaignDM(campaignId) && validStock(request.resource.data);
 allow update: if validStock(request.resource.data) && (isCampaignDM(campaignId) || debitMatches(itemId));
 allow delete: if isCampaignDM(campaignId);
}
match /inventory/{entryId} {
 allow get: if isCampaignDM(campaignId) || (isActiveMember(campaignId) && (!exists(inventoryPath(entryId)) || resource.data.userId == request.auth.uid));
 allow list: if isCampaignDM(campaignId) || ownInventory(resource.data);
 allow create: if (isCampaignDM(campaignId) && validInventory(request.resource.data,entryId)) || claimCredit(request.resource.data,entryId,0);
 allow update: if (isCampaignDM(campaignId) && validInventory(request.resource.data,entryId))
 || (ownInventory(resource.data)
   && request.resource.data.userId == resource.data.userId
   && request.resource.data.characterId == resource.data.characterId
   && request.resource.data.itemId == resource.data.itemId
   && request.resource.data.receivedAt == resource.data.receivedAt
   && (claimCredit(request.resource.data,entryId,resource.data.quantity)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity','updatedAt'])
       && request.resource.data.quantity is int && request.resource.data.quantity > 0
       && request.resource.data.quantity < resource.data.quantity)));
 allow delete: if isCampaignDM(campaignId) || ownInventory(resource.data);
}
match /migrationNotes/{itemId} {
 allow read, write: if isCampaignDM(campaignId);
}
// Legacy records remain available to the DM for migration/audit only.
match /itemState/{itemId} {
  allow read: if isCampaignDM(campaignId);
  allow write: if false;
}
match /itemVisibility/{itemId} {
  allow read: if isCampaignDM(campaignId);
  allow write: if false;
}
}

// -----------------------------------------------------------------------
// DM REQUESTS — roadmap Step 4
//
// Global DM approval only grants campaign-creation capability.
// Campaign authority is still controlled by campaign membership/ownership.
// -----------------------------------------------------------------------
match /dmRequests/{uid} {
  allow read: if isSelf(uid) || isAdmin();

  // A signed-in user may submit exactly one application under their own UID.
  // Email is matched to the authenticated account, but email verification is
  // intentionally NOT required in the current closed/testing product flow.
  allow create: if isSelf(uid)
    && hasAuthEmail()
    && request.resource.data.keys().hasAll([
      "userId",
      "name",
      "email",
      "emailLower",
      "message",
      "experience",
      "status",
      "submittedAt",
      "updatedAt"
    ])
    && request.resource.data.keys().hasOnly([
      "userId",
      "name",
      "email",
      "emailLower",
      "message",
      "experience",
      "status",
      "submittedAt",
      "updatedAt"
    ])
    && request.resource.data.userId == uid
    && request.resource.data.name is string
    && request.resource.data.email == request.auth.token.email
    && request.resource.data.emailLower == authEmailLower()
    && request.resource.data.message is string
    && request.resource.data.experience is string
    && request.resource.data.status == "pending"
    && request.resource.data.submittedAt is int
    && request.resource.data.updatedAt is int;

  // Applicants may only withdraw a pending application or re-submit a
  // rejected/withdrawn/revoked application. They cannot alter reviewer data.
  allow update: if (
      isSelf(uid)
      && resource.data.userId == uid
      && request.resource.data.userId == uid
      && request.resource.data.email == resource.data.email
      && request.resource.data.emailLower == resource.data.emailLower
      && request.resource.data.emailLower == authEmailLower()
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "name",
        "message",
        "experience",
        "status",
        "submittedAt",
        "updatedAt"
      ])
      && (
        (
          resource.data.status == "pending"
          && request.resource.data.status == "withdrawn"
        )
        ||
        (
          resource.data.status in ["rejected", "withdrawn", "revoked"]
          && request.resource.data.status == "pending"
        )
      )
    )
    || (
      isAdmin()
      && request.resource.data.userId == resource.data.userId
      && request.resource.data.status in [
        "pending",
        "approved",
        "rejected",
        "withdrawn",
        "revoked"
      ]
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        "status",
        "reviewedAt",
        "reviewedBy",
        "reviewNote",
        "updatedAt"
      ])
    );

  allow delete: if isAdmin();
}

// -----------------------------------------------------------------------
// LEGACY GLOBAL COLLECTIONS
// Keep admin-readable only while migration is being verified.
// Delete these collections and these rules afterwards.
// -----------------------------------------------------------------------
match /characters/{charId} {
  allow read: if isAdmin();
  allow write: if false;
}

match /wishes/{wishId} {
  allow read: if isAdmin();
  allow write: if false;
}

// Everything else is denied by default.

}
}
