rules_version = '2';
// Production Storage rules. Preserve item-image permissions when adding new paths.
// Firebase Hosting deployments do not publish these rules; deploy Storage separately.
service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/users/$(request.auth.uid)
        )
        && "admin" in firestore.get(
          /databases/(default)/documents/users/$(request.auth.uid)
        ).data.role;
    }

    function isCampaignOwner(campaignId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/campaigns/$(campaignId)
        )
        && firestore.get(
          /databases/(default)/documents/campaigns/$(campaignId)
        ).data.ownerId == request.auth.uid;
    }

    function isActiveMember(campaignId) {
      return signedIn()
        && firestore.exists(
          /databases/(default)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)
        )
        && firestore.get(
          /databases/(default)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)
        ).data.status == "active";
    }

    function isCampaignDM(campaignId) {
      return isCampaignOwner(campaignId)
        || (
          isActiveMember(campaignId)
          && firestore.get(
            /databases/(default)/documents/campaigns/$(campaignId)/members/$(request.auth.uid)
          ).data.role == "dm"
        );
    }

    function validImage() {
      return request.resource != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/(png|jpeg|webp)');
    }

    // Generated illustrations retained with reviewed items remain available.
    // Only the operator can write the publication registry. Retired-only images
    // move to DM-private Storage; existing tokens are removed after verification.
    match /dnd-item-images/{fileName} {
      allow read: if isAdmin() || (
        firestore.exists(/databases/(default)/documents/catalogueArtwork/$(fileName))
        && firestore.get(/databases/(default)/documents/catalogueArtwork/$(fileName)).data.status == 'generated'
        && firestore.get(/databases/(default)/documents/catalogueArtwork/$(fileName)).data.path == 'dnd-item-images/' + fileName
      );
      allow create, update: if isAdmin() && validImage();
      allow delete: if isAdmin();
    }

    // Personal item libraries are independent from campaign membership.
    match /private-item-library-images/{ownerId}/{assetId}/{digest} {
      allow read: if signedIn() && request.auth.uid == ownerId
        && assetId.matches('[a-f0-9]{64}') && digest.matches('[a-f0-9]{64}');
      allow write: if false;
    }

    // Preserved originals are DM-only, with no client writes or token URLs.
    match /campaign-catalogue-images/{campaignId}/{assetId}/{digest} {
      allow read: if isCampaignDM(campaignId);
      allow write: if false;
    }

    // Campaign item images. Unchanged from previously published rules.
    match /campaign-item-images/{campaignId}/{fileName} {
      allow read: if isCampaignOwner(campaignId)
        || isActiveMember(campaignId);

      allow create, update: if isCampaignDM(campaignId)
        && validImage();

      allow delete: if isCampaignDM(campaignId);
    }

    // World Building maps. New images are private to the owner and active DMs.
    // Uploads use unique names, so replacing a map creates a new immutable object.
    match /campaign-world-images/{campaignId}/{entryId}/{imageId} {
      allow read: if isCampaignDM(campaignId);
      allow create: if resource == null
        && isCampaignDM(campaignId)
        && validImage();
    }

    // Journal art belongs to precisely one campaign, record type and entry.
    // Unlike campaign covers, these illustrations remain private to active DMs
    // unless that exact saved illustration is deliberately shared on a player page.
    match /campaign-journal-images/{campaignId}/{kind}/{entryId}/{imageId} {
      function supportedJournalKind() {
        return kind == 'world' || kind == 'creature'
          || kind == 'chapter' || kind == 'encounter';
      }
      function sharedImage() {
        let publication = kind == 'world' ? 'playerInformation' : kind == 'creature' ? 'playerNPCs' : 'playerChapters';
        let path = /databases/(default)/documents/campaigns/$(campaignId)/$(publication)/$(entryId);
        return kind != 'encounter' && firestore.exists(path)
          && 'image' in firestore.get(path).data
          && firestore.get(path).data.image.path == 'campaign-journal-images/' + campaignId + '/' + kind + '/' + entryId + '/' + imageId;
      }
      allow read: if supportedJournalKind() && (isCampaignDM(campaignId)
        || (isActiveMember(campaignId) && sharedImage()));
      // New unique objects only; nothing can overwrite or delete an existing image.
      allow create: if resource == null
        && supportedJournalKind()
        && isCampaignDM(campaignId)
        && validImage();
    }

    // Campaign covers are shared with active members, but only DMs may upload.
    // Immutable object names prevent overwriting another saved cover.
    match /campaign-cover-images/{campaignId}/{imageId} {
      allow read: if isCampaignOwner(campaignId) || isActiveMember(campaignId);
      allow create: if resource == null && isCampaignDM(campaignId) && validImage();
    }

    // Everything else remains denied.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
